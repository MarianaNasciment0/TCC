<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TCC.RegistroPage"
             Title="Criar Nova Conta"
             BackgroundColor="#121212">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <VerticalStackLayout Spacing="4" Margin="0,10,0,10">
                <Label Text="CADASTRO" TextColor="#00E676" FontSize="11" FontAttributes="Bold" CharacterSpacing="1"/>
                <Label Text="Preencha seus dados para começar" TextColor="White" FontSize="20" FontAttributes="Bold"/>
            </VerticalStackLayout>

            <!-- Nome Completo -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Nome Completo" TextColor="#9E9E9E" FontSize="12" FontAttributes="Bold"/>
                <Border BackgroundColor="#1E1E1E" Stroke="#2C2C2C" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                    <Entry x:Name="txtNome"
                           Placeholder="Ex: João da Silva"
                           PlaceholderColor="#616161"
                           TextColor="White"
                           BackgroundColor="Transparent"
                           Margin="10,2"/>
                </Border>
            </VerticalStackLayout>

            <!-- E-mail -->
            <VerticalStackLayout Spacing="4">
                <Label Text="E-mail" TextColor="#9E9E9E" FontSize="12" FontAttributes="Bold"/>
                <Border BackgroundColor="#1E1E1E" Stroke="#2C2C2C" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                    <Entry x:Name="txtEmail"
                           Placeholder="Ex: joao@email.com"
                           PlaceholderColor="#616161"
                           TextColor="White"
                           Keyboard="Email"
                           BackgroundColor="Transparent"
                           Margin="10,2"/>
                </Border>
            </VerticalStackLayout>

            <!-- Senha -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Senha" TextColor="#9E9E9E" FontSize="12" FontAttributes="Bold"/>
                <Border BackgroundColor="#1E1E1E" Stroke="#2C2C2C" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                    <Entry x:Name="txtSenha"
                           Placeholder="Digite sua senha"
                           PlaceholderColor="#616161"
                           TextColor="White"
                           IsPassword="True"
                           BackgroundColor="Transparent"
                           Margin="10,2"/>
                </Border>
            </VerticalStackLayout>

            <!-- Tipo de Perfil -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Tipo de Perfil" TextColor="#9E9E9E" FontSize="12" FontAttributes="Bold"/>
                <Border BackgroundColor="#1E1E1E" Stroke="#2C2C2C" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                    <Picker x:Name="pickerTipoPerfil"
                            Title="Selecione seu perfil"
                            TextColor="White"
                            TitleColor="#616161"
                            BackgroundColor="Transparent"
                            Margin="10,2">
                        <Picker.Items>
                            <x:String>Aluno</x:String>
                            <x:String>Personal Trainer</x:String>
                            <x:String>Nutricionista</x:String>
                            <x:String>Academia</x:String>
                        </Picker.Items>
                    </Picker>
                </Border>
            </VerticalStackLayout>

            <!-- Telefone / WhatsApp -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Telefone / WhatsApp" TextColor="#9E9E9E" FontSize="12" FontAttributes="Bold"/>
                <Border BackgroundColor="#1E1E1E" Stroke="#2C2C2C" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                    <Entry x:Name="txtTelefone"
                           Placeholder="Ex: (11) 98888-7777"
                           PlaceholderColor="#616161"
                           TextColor="White"
                           Keyboard="Telephone"
                           BackgroundColor="Transparent"
                           Margin="10,2"/>
                </Border>
            </VerticalStackLayout>

            <!-- Data de Nascimento -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Data de Nascimento" TextColor="#9E9E9E" FontSize="12" FontAttributes="Bold"/>
                <Border BackgroundColor="#1E1E1E" Stroke="#2C2C2C" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                    <DatePicker x:Name="datePickerNascimento"
                                TextColor="White"
                                BackgroundColor="Transparent"
                                Margin="10,2"/>
                </Border>
            </VerticalStackLayout>

            <!-- Botão Cadastrar -->
            <Button Text="Cadastrar"
                    Clicked="OnCadastrarClicked"
                    BackgroundColor="#00E676"
                    TextColor="#121212"
                    FontAttributes="Bold"
                    FontSize="16"
                    CornerRadius="10"
                    HeightRequest="50"
                    Margin="0,15,0,20"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>