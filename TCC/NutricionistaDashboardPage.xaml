<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TCC.NutricionistaDashboardPage"
             Title="Painel da Nutricionista"
             BackgroundColor="#121212">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20">

            <!-- Card Superior com Dados da Nutricionista -->
            <Border BackgroundColor="#1E1E1E" Stroke="#00E676" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="20">
                <VerticalStackLayout Spacing="8">
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Label Text="🥗" FontSize="28" VerticalOptions="Center"/>
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label x:Name="lblNomeNutri" Text="Olá, Nutricionista!" TextColor="White" FontSize="18" FontAttributes="Bold"/>
                            <Label Text="Perfil: Nutricionista" TextColor="#00E676" FontSize="12" FontAttributes="Bold"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Label Text="GERENCIAMENTO E CONSULTAS" TextColor="#9E9E9E" FontSize="11" FontAttributes="Bold" CharacterSpacing="1"/>

            <!-- 💬 CARTÃO DE MENSAGENS E CHAT (Igual ao do Personal) -->
            <Border BackgroundColor="#1E1E1E" Stroke="#2C2C2C" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="18">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMensagensClicked"/>
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="15" VerticalOptions="Center">
                    <Label Text="💬" FontSize="28" VerticalOptions="Center"/>
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="Mensagens e Chat" TextColor="White" FontSize="16" FontAttributes="Bold"/>
                        <Label Text="Converse com alunos e outros profissionais" TextColor="#9E9E9E" FontSize="12"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Border>

            <!-- Opção: Alunos -->
            <Border BackgroundColor="#1E1E1E" Stroke="#2C2C2C" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="18">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAlunosClicked"/>
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="15" VerticalOptions="Center">
                    <Label Text="🎓" FontSize="30" VerticalOptions="Center"/>
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="Alunos" TextColor="White" FontSize="16" FontAttributes="Bold"/>
                        <Label Text="Visualize fichas, dietas e dados dos alunos" TextColor="#9E9E9E" FontSize="12"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Border>

            <!-- Opção: Editar Plano -->
            <Border BackgroundColor="#1E1E1E" Stroke="#2C2C2C" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="18">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnEditarPlanoClicked"/>
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="15" VerticalOptions="Center">
                    <Label Text="💰" FontSize="30" VerticalOptions="Center"/>
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="Meus Planos e Valores" TextColor="White" FontSize="16" FontAttributes="Bold"/>
                        <Label Text="Configure o valor de suas consultas e dietas" TextColor="#9E9E9E" FontSize="12"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Border>

            <Button Text="SAIR DA CONTA"
                    Clicked="OnSairClicked"
                    BackgroundColor="#2C2C2C"
                    TextColor="#FF5252"
                    FontAttributes="Bold"
                    FontSize="13"
                    CornerRadius="10"
                    HeightRequest="45"
                    Margin="0,10,0,20"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>