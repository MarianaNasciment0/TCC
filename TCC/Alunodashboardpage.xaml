<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TCC.Alunodashboardpage"
             Title="Painel do Aluno"
             BackgroundColor="#121212">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20">

            <Border BackgroundColor="#1E1E1E" Stroke="#00E676" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="20">
                <VerticalStackLayout Spacing="8">
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Label Text="🎓" FontSize="28" VerticalOptions="Center"/>
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label x:Name="lblNomeAluno" Text="Olá, Aluno(a)!" TextColor="White" FontSize="18" FontAttributes="Bold"/>
                            <Label Text="Perfil: Aluno / Atleta" TextColor="#00E676" FontSize="12" FontAttributes="Bold"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Label Text="GERENCIAMENTO E CONSULTAS" TextColor="#9E9E9E" FontSize="11" FontAttributes="Bold" CharacterSpacing="1"/>

            <Border BackgroundColor="#1E1E1E" Stroke="#2C2C2C" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="18">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMensagensClicked"/>
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="15" VerticalOptions="Center">
                    <Label Text="💬" FontSize="28" VerticalOptions="Center"/>
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="Mensagens e Chat" TextColor="White" FontSize="16" FontAttributes="Bold"/>
                        <Label Text="Converse com personals, nutris e academias" TextColor="#9E9E9E" FontSize="12"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Border>

            <Border BackgroundColor="#1E1E1E" Stroke="#2C2C2C" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="18">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPersonalsClicked"/>
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="15" VerticalOptions="Center">
                    <Label Text="🏋️‍♂️" FontSize="28" VerticalOptions="Center"/>
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="Personal Trainers" TextColor="White" FontSize="16" FontAttributes="Bold"/>
                        <Label Text="Consulte personal trainers disponíveis" TextColor="#9E9E9E" FontSize="12"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Border>

            <Border BackgroundColor="#1E1E1E" Stroke="#2C2C2C" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="18">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnNutricionistasClicked"/>
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="15" VerticalOptions="Center">
                    <Label Text="🥗" FontSize="28" VerticalOptions="Center"/>
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="Nutricionistas" TextColor="White" FontSize="16" FontAttributes="Bold"/>
                        <Label Text="Consulte nutricionistas parceiros" TextColor="#9E9E9E" FontSize="12"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Border>

            <Border BackgroundColor="#1E1E1E" Stroke="#2C2C2C" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="18">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAcademiasClicked"/>
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="15" VerticalOptions="Center">
                    <Label Text="🏢" FontSize="28" VerticalOptions="Center"/>
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="Academias" TextColor="White" FontSize="16" FontAttributes="Bold"/>
                        <Label Text="Consulte endereços e unidades parceiras" TextColor="#9E9E9E" FontSize="12"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="10" Margin="0,20,0,20">
                <Button Text="EXCLUIR MINHA CONTA"
                        Clicked="OnExcluirContaClicked"
                        BackgroundColor="#3A1212"
                        TextColor="#FF5252"
                        FontAttributes="Bold"
                        FontSize="13"
                        CornerRadius="10"
                        HeightRequest="45"/>

                <Button Text="SAIR DA CONTA"
                        Clicked="OnSairClicked"
                        BackgroundColor="#2C2C2C"
                        TextColor="#FF5252"
                        FontAttributes="Bold"
                        FontSize="13"
                        CornerRadius="10"
                        HeightRequest="45"/>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>