<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TCC.ListaGenericaProfissionaisPage"
             Title="Lista de Profissionais"
             BackgroundColor="#121212">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Label x:Name="lblTituloSecao" Text="Profissionais" TextColor="#00E676" FontSize="18" FontAttributes="Bold"/>

        <CollectionView x:Name="collectionItens" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="#1E1E1E" Stroke="#2C2C2C" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="15" Margin="0,5">
                        <VerticalStackLayout Spacing="10">

                            <!-- Cabeçalho do Card (Clicável para expandir detalhes) -->
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Label Grid.Column="0" Text="{Binding IconePerfil}" FontSize="24" VerticalOptions="Center" Margin="0,0,10,0"/>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label Text="{Binding Nome}" TextColor="White" FontSize="16" FontAttributes="Bold"/>
                                    <Label Text="{Binding SubtituloCard}" TextColor="#9E9E9E" FontSize="12"/>
                                </VerticalStackLayout>

                                <!-- 💬 Botão de Chat Direto em cada card -->
                                <Button Grid.Column="2" 
                                        Text="💬 Chat" 
                                        Clicked="OnChatDiretoClicked" 
                                        CommandParameter="{Binding}"
                                        BackgroundColor="#00E676" 
                                        TextColor="Black" 
                                        FontSize="12" 
                                        FontAttributes="Bold" 
                                        CornerRadius="8" 
                                        HeightRequest="35"
                                        VerticalOptions="Center"/>
                            </Grid>

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label x:Name="lblNenhumItem" 
               Text="Nenhum item encontrado." 
               TextColor="#9E9E9E" 
               HorizontalOptions="Center" 
               VerticalOptions="CenterAndExpand" 
               IsVisible="False"/>

    </VerticalStackLayout>
</ContentPage>