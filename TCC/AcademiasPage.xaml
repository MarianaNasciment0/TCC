<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TCC.AcademiasPage"
             Title="Academias Parceiras"
             BackgroundColor="#121212">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <VerticalStackLayout Spacing="4">
                <Label Text="REDE PARCEIRA" TextColor="#00E676" FontSize="11" FontAttributes="Bold" CharacterSpacing="1"/>
                <Label Text="Academias Disponíveis" TextColor="White" FontSize="20" FontAttributes="Bold"/>
                <Label Text="Toque em um card para expandir os detalhes e contactos" TextColor="#9E9E9E" FontSize="12"/>
            </VerticalStackLayout>

            <CollectionView x:Name="collectionAcademias" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="#1E1E1E" Stroke="#2C2C2C" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="15" Margin="0,6">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCardTapped" CommandParameter="{Binding}"/>
                            </Border.GestureRecognizers>

                            <VerticalStackLayout Spacing="10">
                                <!-- CABEÇALHO DO CARD -->
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <Label Grid.Column="0" Text="🏢" FontSize="26" VerticalOptions="Center" Margin="0,0,10,0"/>

                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Nome}" TextColor="White" FontSize="17" FontAttributes="Bold"/>
                                        <Label Text="Academia Parceira" TextColor="#00E676" FontSize="12" FontAttributes="Bold"/>
                                        <Label Text="{Binding Rua, StringFormat='Endereço: {0}'}" TextColor="#B0BEC5" FontSize="12"/>
                                    </VerticalStackLayout>

                                    <Label Grid.Column="2" Text="▼" TextColor="#00E676" FontSize="12" VerticalOptions="Center"/>
                                </Grid>

                                <!-- CONTEÚDO EXPANDIDO -->
                                <VerticalStackLayout Spacing="10" IsVisible="{Binding IsExpanded}">
                                    <BoxView HeightRequest="1" BackgroundColor="#2C2C2C" Margin="0,2"/>

                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding Email, StringFormat='E-mail: {0}'}" TextColor="#B0BEC5" FontSize="12"/>
                                        <Label Text="{Binding Telefone, StringFormat='Telefone: {0}'}" TextColor="#B0BEC5" FontSize="12"/>
                                        <Label Text="{Binding Documento, StringFormat='CNPJ: {0}'}" TextColor="#B0BEC5" FontSize="12"/>
                                        <Label Text="{Binding Numero, StringFormat='Número / Sala: {0}'}" TextColor="#B0BEC5" FontSize="12"/>
                                    </VerticalStackLayout>

                                    <!-- Botão de Chat Direto com a Academia -->
                                    <Button Text="💬 Entrar em Contato via Chat"
                                            Clicked="OnChatAcademiaClicked"
                                            CommandParameter="{Binding}"
                                            BackgroundColor="#00E676"
                                            TextColor="#121212"
                                            FontAttributes="Bold"
                                            FontSize="14"
                                            CornerRadius="10"
                                            HeightRequest="44"
                                            Margin="0,5,0,0"/>
                                </VerticalStackLayout>

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label x:Name="lblNenhumaAcademia"
                   Text="Nenhuma academia cadastrada no momento."
                   TextColor="#616161"
                   HorizontalTextAlignment="Center"
                   IsVisible="False"
                   Margin="0,30,0,0"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>