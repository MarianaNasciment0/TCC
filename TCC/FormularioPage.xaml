<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TCC.FormularioPage"
             BackgroundColor="#121212">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20">

            <!-- Cabeçalho Dinâmico -->
            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                <BoxView WidthRequest="4" HeightRequest="32" Color="#00E676" CornerRadius="2"/>
                <VerticalStackLayout>
                    <Label Text="PAINEL DE AUTENTICAÇÃO" TextColor="#9E9E9E" FontSize="11" FontAttributes="Bold" CharacterSpacing="1"/>
                    <Label x:Name="lblTituloPerfil" Text="Perfil" TextColor="White" FontSize="20" FontAttributes="Bold"/>
                </VerticalStackLayout>
            </HorizontalStackLayout>

            <!-- Seletor de Ação (Login ou Cadastro) -->
            <Border BackgroundColor="#1E1E1E" StrokeThickness="0" StrokeShape="RoundRectangle 12">
                <Picker x:Name="pickerAcao"
                        Title="Selecione a Ação"
                        SelectedIndexChanged="OnAcaoChanged"
                        TextColor="White"
                        TitleColor="#9E9E9E"
                        BackgroundColor="Transparent"
                        FontSize="14"
                        Margin="10,5">
                    <Picker.Items>
                        <x:String>Entrar na minha conta (Login)</x:String>
                        <x:String>Criar novo cadastro (Registro)</x:String>
                    </Picker.Items>
                </Picker>
            </Border>

            <!-- ================= LOGIN ================= -->
            <VerticalStackLayout x:Name="layoutLogin" Spacing="15" IsVisible="True">
                <Label Text="Informe suas credenciais para entrar." TextColor="#B0BEC5" FontSize="13"/>

                <VerticalStackLayout Spacing="6">
                    <Label Text="E-MAIL" TextColor="#00E676" FontSize="11" FontAttributes="Bold"/>
                    <Border BackgroundColor="#1E1E1E" Stroke="#2C2C2C" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                        <Entry x:Name="txtEmail" Placeholder="exemplo@email.com" PlaceholderColor="#616161" TextColor="White" Keyboard="Email" Margin="10,2"/>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="SENHA" TextColor="#00E676" FontSize="11" FontAttributes="Bold"/>
                    <Border BackgroundColor="#1E1E1E" Stroke="#2C2C2C" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                        <Entry x:Name="txtSenha" Placeholder="Sua senha" PlaceholderColor="#616161" TextColor="White" IsPassword="True" Margin="10,2"/>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>


            <!-- ================= CADASTRO: ALUNO ================= -->
            <VerticalStackLayout x:Name="layoutCadastroAluno" Spacing="15" IsVisible="False">
                <Label Text="Preencha os dados do Aluno." TextColor="#B0BEC5" FontSize="13"/>
                <VerticalStackLayout Spacing="6">
                    <Label Text="NOME COMPLETO" TextColor="#00E676" FontSize="11" FontAttributes="Bold"/>
                    <Border BackgroundColor="#1E1E1E" Stroke="#2C2C2C" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                        <Entry x:Name="txtNomeAluno" Placeholder="Nome" PlaceholderColor="#616161" TextColor="White" Margin="10,2"/>
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6">
                    <Label Text="CPF" TextColor="#00E676" FontSize="11" FontAttributes="Bold"/>
                    <Border BackgroundColor="#1E1E1E" Stroke="#2C2C2C" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                        <Entry x:Name="txtCpfAluno" Placeholder="000.000.000-00" PlaceholderColor="#616161" TextColor="White" Keyboard="Numeric" Margin="10,2"/>
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6">
                    <Label Text="E-MAIL" TextColor="#00E676" FontSize="11" FontAttributes="Bold"/>
                    <Border BackgroundColor="#1E1E1E" Stroke="#2C2C2C" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                        <Entry x:Name="txtEmailAluno" Placeholder="email@aluno.com" PlaceholderColor="#616161" TextColor="White" Keyboard="Email" Margin="10,2"/>
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6">
                    <Label Text="SENHA" TextColor="#00E676" FontSize="11" FontAttributes="Bold"/>
                    <Border BackgroundColor="#1E1E1E" Stroke="#2C2C2C" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                        <Entry x:Name="txtSenhaAluno" Placeholder="Senha" PlaceholderColor="#616161" TextColor="White" IsPassword="True" Margin="10,2"/>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>


            <!-- ================= CADASTRO: PERSONAL ================= -->
            <VerticalStackLayout x:Name="layoutCadastroPersonal" Spacing="15" IsVisible="False">
                <Label Text="Preencha os dados do Personal Trainer." TextColor="#B0BEC5" FontSize="13"/>
                <VerticalStackLayout Spacing="6">
                    <Label Text="NOME COMPLETO" TextColor="#00E676" FontSize="11" FontAttributes="Bold"/>
                    <Border BackgroundColor="#1E1E1E" Stroke="#2C2C2C" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                        <Entry x:Name="txtNomePersonal" Placeholder="Nome" PlaceholderColor="#616161" TextColor="White" Margin="10,2"/>
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6">
                    <Label Text="CREF" TextColor="#00E676" FontSize="11" FontAttributes="Bold"/>
                    <Border BackgroundColor="#1E1E1E" Stroke="#2C2C2C" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                        <Entry x:Name="txtCrefPersonal" Placeholder="CREF" PlaceholderColor="#616161" TextColor="White" Margin="10,2"/>
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6">
                    <Label Text="ESPECIALIDADES" TextColor="#00E676" FontSize="11" FontAttributes="Bold"/>
                    <Border BackgroundColor="#1E1E1E" Stroke="#2C2C2C" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                        <Entry x:Name="txtEspecialidadesPersonal" Placeholder="Ex: Musculação" PlaceholderColor="#616161" TextColor="White" Margin="10,2"/>
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6">
                    <Label Text="E-MAIL" TextColor="#00E676" FontSize="11" FontAttributes="Bold"/>
                    <Border BackgroundColor="#1E1E1E" Stroke="#2C2C2C" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                        <Entry x:Name="txtEmailPersonal" Placeholder="email@personal.com" PlaceholderColor="#616161" TextColor="White" Keyboard="Email" Margin="10,2"/>
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6">
                    <Label Text="SENHA" TextColor="#00E676" FontSize="11" FontAttributes="Bold"/>
                    <Border BackgroundColor="#1E1E1E" Stroke="#2C2C2C" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                        <Entry x:Name="txtSenhaPersonal" Placeholder="Senha" PlaceholderColor="#616161" TextColor="White" IsPassword="True" Margin="10,2"/>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>


            <!-- ================= CADASTRO: NUTRICIONISTA ================= -->
            <VerticalStackLayout x:Name="layoutCadastroNutri" Spacing="15" IsVisible="False">
                <Label Text="Preencha os dados da Nutricionista." TextColor="#B0BEC5" FontSize="13"/>
                <VerticalStackLayout Spacing="6">
                    <Label Text="NOME COMPLETO" TextColor="#00E676" FontSize="11" FontAttributes="Bold"/>
                    <Border BackgroundColor="#1E1E1E" Stroke="#2C2C2C" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                        <Entry x:Name="txtNomeNutri" Placeholder="Nome" PlaceholderColor="#616161" TextColor="White" Margin="10,2"/>
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6">
                    <Label Text="CRN" TextColor="#00E676" FontSize="11" FontAttributes="Bold"/>
                    <Border BackgroundColor="#1E1E1E" Stroke="#2C2C2C" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                        <Entry x:Name="txtCrnNutri" Placeholder="CRN" PlaceholderColor="#616161" TextColor="White" Margin="10,2"/>
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6">
                    <Label Text="ÁREA DE ATUAÇÃO" TextColor="#00E676" FontSize="11" FontAttributes="Bold"/>
                    <Border BackgroundColor="#1E1E1E" Stroke="#2C2C2C" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                        <Entry x:Name="txtEspecialidadesNutri" Placeholder="Ex: Esportiva" PlaceholderColor="#616161" TextColor="White" Margin="10,2"/>
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6">
                    <Label Text="E-MAIL" TextColor="#00E676" FontSize="11" FontAttributes="Bold"/>
                    <Border BackgroundColor="#1E1E1E" Stroke="#2C2C2C" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                        <Entry x:Name="txtEmailNutri" Placeholder="email@nutri.com" PlaceholderColor="#616161" TextColor="White" Keyboard="Email" Margin="10,2"/>
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6">
                    <Label Text="SENHA" TextColor="#00E676" FontSize="11" FontAttributes="Bold"/>
                    <Border BackgroundColor="#1E1E1E" Stroke="#2C2C2C" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                        <Entry x:Name="txtSenhaNutri" Placeholder="Senha" PlaceholderColor="#616161" TextColor="White" IsPassword="True" Margin="10,2"/>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>


            <!-- ================= CADASTRO: ACADEMIA ================= -->
            <VerticalStackLayout x:Name="layoutCadastroAcademia" Spacing="15" IsVisible="False">
                <Label Text="Preencha os dados da Academia." TextColor="#B0BEC5" FontSize="13"/>
                <VerticalStackLayout Spacing="6">
                    <Label Text="NOME DA ACADEMIA" TextColor="#00E676" FontSize="11" FontAttributes="Bold"/>
                    <Border BackgroundColor="#1E1E1E" Stroke="#2C2C2C" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                        <Entry x:Name="txtNomeEmpresa" Placeholder="Nome" PlaceholderColor="#616161" TextColor="White" Margin="10,2"/>
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6">
                    <Label Text="CNPJ" TextColor="#00E676" FontSize="11" FontAttributes="Bold"/>
                    <Border BackgroundColor="#1E1E1E" Stroke="#2C2C2C" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                        <Entry x:Name="txtCnpjEmpresa" Placeholder="CNPJ" PlaceholderColor="#616161" TextColor="White" Keyboard="Numeric" Margin="10,2"/>
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6">
                    <Label Text="E-MAIL" TextColor="#00E676" FontSize="11" FontAttributes="Bold"/>
                    <Border BackgroundColor="#1E1E1E" Stroke="#2C2C2C" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                        <Entry x:Name="txtEmailEmpresa" Placeholder="email@academia.com" PlaceholderColor="#616161" TextColor="White" Keyboard="Email" Margin="10,2"/>
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6">
                    <Label Text="SENHA" TextColor="#00E676" FontSize="11" FontAttributes="Bold"/>
                    <Border BackgroundColor="#1E1E1E" Stroke="#2C2C2C" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                        <Entry x:Name="txtSenhaEmpresa" Placeholder="Senha" PlaceholderColor="#616161" TextColor="White" IsPassword="True" Margin="10,2"/>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>


            <!-- ================= CADASTRO: ADMINISTRADOR ================= -->
            <VerticalStackLayout x:Name="layoutCadastroAdmin" Spacing="15" IsVisible="False">
                <Label Text="Preencha os dados do Administrador." TextColor="#B0BEC5" FontSize="13"/>
                <VerticalStackLayout Spacing="6">
                    <Label Text="NOME" TextColor="#00E676" FontSize="11" FontAttributes="Bold"/>
                    <Border BackgroundColor="#1E1E1E" Stroke="#2C2C2C" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                        <Entry x:Name="txtNomeAdmin" Placeholder="Nome" PlaceholderColor="#616161" TextColor="White" Margin="10,2"/>
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6">
                    <Label Text="DOCUMENTO" TextColor="#00E676" FontSize="11" FontAttributes="Bold"/>
                    <Border BackgroundColor="#1E1E1E" Stroke="#2C2C2C" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                        <Entry x:Name="txtDocumentoAdmin" Placeholder="CPF ou Registro" PlaceholderColor="#616161" TextColor="White" Margin="10,2"/>
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6">
                    <Label Text="E-MAIL" TextColor="#00E676" FontSize="11" FontAttributes="Bold"/>
                    <Border BackgroundColor="#1E1E1E" Stroke="#2C2C2C" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                        <Entry x:Name="txtEmailAdmin" Placeholder="email@admin.com" PlaceholderColor="#616161" TextColor="White" Keyboard="Email" Margin="10,2"/>
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6">
                    <Label Text="SENHA" TextColor="#00E676" FontSize="11" FontAttributes="Bold"/>
                    <Border BackgroundColor="#1E1E1E" Stroke="#2C2C2C" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                        <Entry x:Name="txtSenhaAdmin" Placeholder="Senha" PlaceholderColor="#616161" TextColor="White" IsPassword="True" Margin="10,2"/>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Botão de Ação -->
            <Button Text="CONFIRMAR"
                    Clicked="OnSalvarClicked"
                    BackgroundColor="#00E676"
                    TextColor="#121212"
                    FontAttributes="Bold"
                    FontSize="15"
                    CornerRadius="12"
                    HeightRequest="52"
                    Margin="0,10,0,30"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>