<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TCC.AcademiaAlunosPage"
             Title="Alunos na Academia"
             BackgroundColor="#121212">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Label Text="CONTROLE DE ACESSO" TextColor="#00E676" FontSize="12" FontAttributes="Bold"/>
        <Label Text="Alunos e Status de Acesso" TextColor="White" FontSize="18" FontAttributes="Bold"/>

        <CollectionView x:Name="collectionAlunos" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="#1E1E1E" Stroke="#2C2C2C" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="15" Margin="0,5">
                        <VerticalStackLayout Spacing="12">

                            <!-- Dados do Aluno -->
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{Binding Nome}" TextColor="White" FontSize="16" FontAttributes="Bold"/>
                                <Label Text="{Binding Email}" TextColor="#9E9E9E" FontSize="12"/>
                                <Label Text="{Binding Documento, StringFormat='CPF: {0}'}" TextColor="#00E676" FontSize="12"/>
                                <Label Text="{Binding Telefone, StringFormat='Tel: {0}'}" TextColor="#9E9E9E" FontSize="12"/>
                            </VerticalStackLayout>

                            <!-- Botões Empilhados de Ponta a Ponta -->
                            <VerticalStackLayout Spacing="8">
                                <Button Text="Bloquear / Desbloquear Acesso" 
                                        Clicked="OnBloquearClicked" 
                                        CommandParameter="{Binding}"
                                        BackgroundColor="#2C2C2C" 
                                        TextColor="White" 
                                        FontSize="12" 
                                        CornerRadius="8"
                                        HeightRequest="40"
                                        HorizontalOptions="Fill"/>

                                <Button Text="💬 Iniciar Chat" 
                                        Clicked="OnChatDiretoClicked" 
                                        CommandParameter="{Binding}"
                                        BackgroundColor="#00E676" 
                                        TextColor="Black" 
                                        FontSize="12" 
                                        FontAttributes="Bold" 
                                        CornerRadius="8"
                                        HeightRequest="40"
                                        HorizontalOptions="Fill"/>
                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>