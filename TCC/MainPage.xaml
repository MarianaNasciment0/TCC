<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TCC.MainPage"
             BackgroundColor="#121212"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20">

            <!-- Cabeçalho -->
            <VerticalStackLayout Spacing="4" Margin="0,10,0,10">
                <Label Text="CENTRAL DE ACESSO" TextColor="#00E676" FontSize="12" FontAttributes="Bold" CharacterSpacing="1"/>
                <Label Text="Escolha seu perfil para continuar" TextColor="White" FontSize="22" FontAttributes="Bold"/>
            </VerticalStackLayout>

            <!-- Botão 1: Aluno / Atleta -->
            <Border BackgroundColor="#1E1E1E" Stroke="#2C2C2C" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="18">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAlunoClicked"/>
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="15" VerticalOptions="Center">
                    <Label Text="🎓" FontSize="28" VerticalOptions="Center"/>
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="Aluno / Atleta" TextColor="White" FontSize="16" FontAttributes="Bold"/>
                        <Label Text="Acesse seus treinos, dietas e evolução" TextColor="#9E9E9E" FontSize="12"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Border>

            <!-- Botão 2: Personal Trainer -->
            <Border BackgroundColor="#1E1E1E" Stroke="#2C2C2C" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="18">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPersonalClicked"/>
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="15" VerticalOptions="Center">
                    <Label Text="🏋️‍♂️" FontSize="28" VerticalOptions="Center"/>
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="Personal Trainer" TextColor="White" FontSize="16" FontAttributes="Bold"/>
                        <Label Text="Gerencie alunos e crie fichas de treino" TextColor="#9E9E9E" FontSize="12"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Border>

            <!-- Botão 3: Nutricionista -->
            <Border BackgroundColor="#1E1E1E" Stroke="#2C2C2C" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="18">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnNutricionistaClicked"/>
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="15" VerticalOptions="Center">
                    <Label Text="🥗" FontSize="28" VerticalOptions="Center"/>
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="Nutricionista" TextColor="White" FontSize="16" FontAttributes="Bold"/>
                        <Label Text="Elabore e acompanhe planos alimentares" TextColor="#9E9E9E" FontSize="12"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Border>

            <!-- Botão 4: Academia -->
            <Border BackgroundColor="#1E1E1E" Stroke="#2C2C2C" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="18">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAcademiaClicked"/>
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="15" VerticalOptions="Center">
                    <Label Text="📊" FontSize="28" VerticalOptions="Center"/>
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="Academia" TextColor="White" FontSize="16" FontAttributes="Bold"/>
                        <Label Text="Gestão de estabelecimentos e desempenho" TextColor="#9E9E9E" FontSize="12"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Border>

            <!-- Botão 5: Administrador -->
            <Border BackgroundColor="#1E1E1E" Stroke="#2C2C2C" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="18">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAdminClicked"/>
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="15" VerticalOptions="Center">
                    <Label Text="🛠️" FontSize="28" VerticalOptions="Center"/>
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="Administrador" TextColor="White" FontSize="16" FontAttributes="Bold"/>
                        <Label Text="Acesso geral ao sistema e controles" TextColor="#9E9E9E" FontSize="12"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>