<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TCC.ListaProfissionaisPage"
             Title="Profissionais Disponíveis"
             BackgroundColor="#121212">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <VerticalStackLayout Spacing="4">
                <Label Text="REDES DE APOIO" TextColor="#00E676" FontSize="11" FontAttributes="Bold" CharacterSpacing="1"/>
                <Label Text="Personal Trainers e Nutricionistas" TextColor="White" FontSize="20" FontAttributes="Bold"/>
                <Label Text="Toque em um card para expandir detalhes e iniciar chat" TextColor="#9E9E9E" FontSize="12"/>
            </VerticalStackLayout>

            <CollectionView x:Name="collectionProfissionais" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="#1E1E1E" Stroke="#2C2C2C" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="15" Margin="0,6">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCardTapped" CommandParameter="{Binding}"/>
                            </Border.GestureRecognizers>

                            <VerticalStackLayout Spacing="10">
                                <!-- CABEÇALHO DO CARD -->
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <Label Grid.Column="0" Text="👤" FontSize="24" VerticalOptions="Start" Margin="0,2,10,0"/>

                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="{Binding Nome}" TextColor="White" FontSize="17" FontAttributes="Bold"/>
                                        <Label Text="{Binding TipoPerfil}" TextColor="#00E676" FontSize="12" FontAttributes="Bold"/>
                                        <Label Text="{Binding Especialidades, StringFormat='Área/Especialidade: {0}'}" TextColor="#B0BEC5" FontSize="13"/>
                                    </VerticalStackLayout>

                                    <Label Grid.Column="2" Text="▼" TextColor="#9E9E9E" FontSize="12" VerticalOptions="Start" Margin="0,4,0,0"/>
                                </Grid>

                                <!-- CONTEÚDO EXPANDIDO -->
                                <VerticalStackLayout Spacing="10" IsVisible="{Binding IsExpanded}">
                                    <BoxView HeightRequest="1" BackgroundColor="#2C2C2C" Margin="0,4"/>

                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding Email, StringFormat='E-mail: {0}'}" TextColor="#B0BEC5" FontSize="13"/>
                                        <Label Text="{Binding Telefone, StringFormat='Telefone: {0}'}" TextColor="#B0BEC5" FontSize="13"/>
                                        <Label Text="{Binding Documento, StringFormat='Registro / Documento: {0}'}" TextColor="#B0BEC5" FontSize="13"/>
                                    </VerticalStackLayout>

                                    <Border BackgroundColor="#121212" Stroke="#2C2C2C" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10" IsVisible="{Binding DescricaoPlano}">
                                        <VerticalStackLayout Spacing="4">
                                            <Label Text="📋 Planos e Valores:" TextColor="#00E676" FontSize="12" FontAttributes="Bold"/>
                                            <Label Text="{Binding DescricaoPlano}" TextColor="White" FontSize="13"/>
                                        </VerticalStackLayout>
                                    </Border>

                                    <VerticalStackLayout Spacing="2" IsVisible="{Binding Objetivo}">
                                        <Label Text="⏰ Disponibilidade / Horários:" TextColor="#9E9E9E" FontSize="12" FontAttributes="Bold"/>
                                        <Label Text="{Binding Objetivo}" TextColor="#E0E0E0" FontSize="13"/>
                                    </VerticalStackLayout>

                                    <!-- BOTÃO DE CHAT DIRETO -->
                                    <Button Text="💬 Conversar via Chat Direto"
                                            Clicked="OnChatDiretoClicked"
                                            CommandParameter="{Binding}"
                                            BackgroundColor="#00E676"
                                            TextColor="#121212"
                                            FontAttributes="Bold"
                                            FontSize="14"
                                            CornerRadius="10"
                                            HeightRequest="45"
                                            Margin="0,5,0,0"/>
                                </VerticalStackLayout>

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label x:Name="lblNenhumProfissional"
                   Text="Nenhum profissional cadastrado no momento."
                   TextColor="#616161"
                   HorizontalTextAlignment="Center"
                   IsVisible="False"
                   Margin="0,30,0,0"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>